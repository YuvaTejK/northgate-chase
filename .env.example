# This prototype stores synthetic data locally and never connects to an email gateway.
PORT=4174
DATABASE_PATH=./data/northgate.sqlite
OVERDUE_AFTER_DAYS=7
DUE_SOON_DAYS=2
GEMINI_API_KEY=replace_with_your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
