{
  "name": "northgate-chase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:assistant\" \"npm:dev:web\"",
    "dev:api": "node --watch src/server/index.ts",
    "dev:assistant": "python -m uvicorn assistant.app.main:app --host 127.0.0.1 --port 4175 --reload",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node src/server/index.ts",
    "test": "node --test && python -m pytest assistant/tests",
    "test:assistant": "python -m pytest assistant/tests"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
